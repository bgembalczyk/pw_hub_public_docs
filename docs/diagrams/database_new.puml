@startuml

skinparam linetype ortho

' ============================================================================
' USERS & AUTHENTICATION
' ============================================================================

entity Users.User {
    * id : <<autogenerated>>
    --
    * username : string
    * email : email
    * name : string
    --
    * is_superuser : bool
    * is_active : bool
    * date_joined : datetime
    * last_login : datetime
    --
    preferred_language : string (PL/EN)
}

note bottom of Users.User
  Integration with USOS and MS SSO planned.
  Uses Django AbstractUser as base.
end note

entity Users.Preference {
    * id : number <<generated>>
    --
    * user : Users.User
    --
    units : List<Units.Unit>
    tags : List<string>
    receive_event_notifications : bool
    receive_announcement_notifications : bool
    receive_usos_reminders : bool
}

' ============================================================================
' PERMISSIONS & AUTHORIZATION
' ============================================================================

entity Permissions.Permission_Group {
    * id : number <<generated>>
    --
    * permission_scheme : Permission_Scheme
    * name : string
    * description : string
    --
    users : List<Users>
}

entity Permissions.Permission_Scheme {
    * id : number <<generated>>
    --
    * name : string
    * description : string
    --
    * permissions : List<Permission>
}

entity Permissions.Permission {
    * id : number <<generated>>
    --
    * resource : Resource
    * can_create : bool
    * can_read : bool
    * can_update : bool
    * can_delete : bool
}

' ============================================================================
' ORGANIZATIONAL UNITS
' ============================================================================

entity Units.Unit {
    * id : number <<generated>>
    --
    * name : string
    * short_name : string
    * description : text
    --
    * parent_unit : Unit
    * unit_head : Users.User
    --
    created_at : datetime
    updated_at : datetime
}

note bottom of Units.Unit
  Represents faculties, departments,
  student organizations, etc.
end note

' ============================================================================
' ANNOUNCEMENTS / NEWS
' ============================================================================

entity Announcements.Announcement {
    * id : number <<generated>>
    --
    * title : string
    * content : text
    * excerpt : text
    * created_at : datetime
    * updated_at : datetime
    --
    * author : Users.User
    * unit_author : Units.Unit
    --
    published : bool
    published_at : datetime
    --
    language : string (PL/EN)
}

entity Announcements.Category {
    * id : number <<generated>>
    --
    * name : string
    * slug : string
    * color : string
    * icon : string
    --
    announcements : List<Announcement>
}

note bottom of Announcements.Category
  Examples: Uczelnia, Kwaterunek, 
  Rekrutacja, Samorząd
end note

entity Announcements.Image {
    * id : number <<generated>>
    --
    * announcement : Announcement
    * image : file
    * alt_text : string
    * is_primary : bool
}

' ============================================================================
' EVENTS
' ============================================================================

entity Events.Event {
    * id : number <<generated>>
    --
    * title : string
    * description : text
    * start_time : datetime
    * end_time : datetime
    --
    * location : GIS.Map.Place
    * organizer : Units.Unit
    --
    language : string (PL/EN)
    is_published : bool
    registration_required : bool
    registration_deadline : datetime
    capacity : integer
    --
    created_at : datetime
    updated_at : datetime
    created_by : Users.User
}

entity Events.Category {
    * id : number <<generated>>
    --
    * name : string
    * slug : string
    * icon : string
    * color : string
    --
    events : List<Event>
}

note bottom of Events.Category
  Examples: Kultura, Sport, Nauka,
  Integracja, Wyjazdy, Konferencje,
  Imprezy, Technologia
end note

entity Events.Registration {
    * id : number <<generated>>
    --
    * event : Event
    * user : Users.User
    --
    * registered_at : datetime
    * status : string (confirmed/cancelled/waitlist)
    --
    participant_name : string
    participant_email : email
    participant_id_number : string
    --
    notes : text
}

entity Events.Ticket {
    * id : number <<generated>>
    --
    * registration : Registration
    --
    * ticket_code : string (UUID)
    * qr_code : image
    --
    * issued_at : datetime
    * scanned_at : datetime
    * is_valid : bool
}

entity Events.Accessibility {
    * id : number <<generated>>
    --
    * event : Event
    --
    wheelchair_accessible : bool
    elevator_available : bool
    quiet_event : bool
    low_sensory_stimulation : bool
    sign_language_available : bool
    live_streaming : bool
    --
    accessibility_notes : text
}

entity Events.FAQ {
    * id : number <<generated>>
    --
    * event : Event
    --
    * question : text
    * answer : text
    * order : integer
    * helpful_count : integer
    --
    created_at : datetime
}

entity Events.Attachment {
    * id : number <<generated>>
    --
    * event : Event
    --
    * title : string
    * description : text
    * file : file (optional)
    * url : url (optional)
    * file_type : string (pdf/link/image)
    * icon : string
    --
    created_at : datetime
}

note bottom of Events.Attachment
  Examples: Agenda, Regulamin, 
  Discord link, etc.
end note

entity Events.Photo {
    * id : number <<generated>>
    --
    * event : Event
    --
    * image : file
    * alt_text : string
    * caption : text
    * order : integer
    --
    uploaded_at : datetime
}

entity Events.Cost {
    * id : number <<generated>>
    --
    * event : Event
    --
    * participant_type : string
    * amount : decimal
    * currency : string
    * description : text
}

note bottom of Events.Cost
  Different costs for different
  participant types (students, external)
end note

' ============================================================================
' GIS / MAPS
' ============================================================================

entity GIS.Map.Place {
    * id : number <<generated>>
    --
    * name : string
    * description : text
    * address : string
    --
    * unit : Units.Unit
    --
    * polygons : List<Polygon>
    * latitude : decimal
    * longitude : decimal
    --
    building_number : string
    room_number : string
    floor : integer
    --
    wheelchair_accessible : bool
    has_elevator : bool
}

entity GIS.Map.Route {
    * id : number <<generated>>
    --
    * start_place : Place
    * end_place : Place
    --
    * waypoints : List<Coordinate>
    * distance : decimal
    * estimated_time : integer
    * accessible_route : bool
}

' ============================================================================
' GUIDES & TUTORIALS
' ============================================================================

entity Guides.Guide {
    * id : number <<generated>>
    --
    * title : string
    * summary : text
    * content : text
    --
    * author : Users.User
    * category : Guide.Category
    --
    * image : file
    * source : string
    --
    published : bool
    published_at : datetime
    created_at : datetime
    updated_at : datetime
    --
    language : string (PL/EN)
}

entity Guides.Category {
    * id : number <<generated>>
    --
    * name : string
    * slug : string
    * icon : string
    * order : integer
    --
    guides : List<Guide>
}

entity Guides.Contact {
    * id : number <<generated>>
    --
    * name : string
    * description : text
    * contact_type : string
    --
    * unit : Units.Unit
    --
    location : string
    room_number : string
    opening_hours : string
    --
    email : email
    phone : string
    website : url
    --
    icon : string
    order : integer
    --
    created_at : datetime
    updated_at : datetime
}

note bottom of Guides.Contact
  Examples: Dziekanat, WRS, 
  Rada Mieszkańców, etc.
end note

' ============================================================================
' USOS INTEGRATION
' ============================================================================

entity USOS.Reminder {
    * id : number <<generated>>
    --
    * user : Users.User
    --
    * reminder_type : string
    * title : string
    * description : text
    --
    * due_date : datetime
    * created_at : datetime
    --
    is_read : bool
    is_dismissed : bool
}

note bottom of USOS.Reminder
  Types: zapisy_na_zajecia, egzamin,
  platnosc, termin_administracyjny
end note

entity USOS.Sync {
    * id : number <<generated>>
    --
    * user : Users.User
    --
    * last_sync : datetime
    * sync_status : string
    * error_message : text
}

' ============================================================================
' NOTIFICATIONS
' ============================================================================

entity Notifications.Notification {
    * id : number <<generated>>
    --
    * user : Users.User
    --
    * notification_type : string
    * title : string
    * message : text
    --
    * related_object_type : string
    * related_object_id : integer
    --
    * created_at : datetime
    * read_at : datetime
    * is_read : bool
    --
    push_sent : bool
    push_sent_at : datetime
}

note bottom of Notifications.Notification
  Types: event_reminder, new_announcement,
  usos_reminder, event_registration_confirmed
end note

' ============================================================================
' RELATIONSHIPS
' ============================================================================

' Permissions
Permissions.Permission }|--o{ Permissions.Permission_Scheme::permissions
Permissions.Permission_Scheme }|--o{ Permissions.Permission_Group
Permissions.Permission_Group }|--o{ Users.User::users

' Users
Users.Preference ||--|| Users.User
Users.Preference }|--o{ Units.Unit::units

' Units
Units.Unit ||--o{ Units.Unit::parent_unit
Units.Unit ||--o{ Users.User::unit_head

' Announcements
Announcements.Announcement ||--|| Users.User::author
Announcements.Announcement ||--o| Units.Unit::unit_author
Announcements.Announcement }|--o{ Announcements.Category
Announcements.Image }|--|| Announcements.Announcement

' Events
Events.Event ||--|| Units.Unit::organizer
Events.Event::location ||--o| GIS.Map.Place
Events.Event }|--|| Users.User::created_by
Events.Event }|--o{ Events.Category

Events.Registration }|--|| Events.Event
Events.Registration }|--|| Users.User

Events.Ticket ||--|| Events.Registration

Events.Accessibility ||--|| Events.Event

Events.FAQ }|--|| Events.Event

Events.Attachment }|--|| Events.Event

Events.Photo }|--|| Events.Event

Events.Cost }|--|| Events.Event

' GIS
GIS.Map.Place::unit ||--o| Units.Unit
GIS.Map.Route }|--|| GIS.Map.Place::start_place
GIS.Map.Route }|--|| GIS.Map.Place::end_place

' Guides
Guides.Guide }|--|| Users.User::author
Guides.Guide }|--|| Guides.Category
Guides.Contact }|--o| Units.Unit

' USOS
USOS.Reminder }|--|| Users.User
USOS.Sync ||--|| Users.User

' Notifications
Notifications.Notification }|--|| Users.User

@enduml
