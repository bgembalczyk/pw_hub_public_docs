@startuml

skinparam linetype ortho

entity Users.User {
    * id : <<autogenerated>>
    --
    * name : string
    * surname : string
    * email : email
    --
    * is_superuser : bool
}

note bottom of Users.User
  Kiedyś trzeba będzie to połączyć z USOS i MS
end note

entity Users.Preference {
    * id : number <<generated>>
    --
    * user : Users.User
    * units : List<Units.Unit>
    * tags : List<string>
}

entity Permissions.Permission_Group {
    * id : number <<generated>>
    --
    * permission_scheme : Permission_Scheme
    * name : string
    * description : string
    --
    users : List<Users>
}

entity Permissions.Permission_Scheme {
    * id : number <<generated>>
    --
    * name : string
    * description : string
    --
    * permissions : List<Permission>
}

entity Permissions.Permission {
    * id : number <<generated>>
    --
    * resource : Resource
    * can_create : bool
    * can_read : bool
    * can_update : bool
    * can_delete : bool
}

entity Units.Unit {
    * id : number <<generated>>
    --
    * name : string
    --
    * parent_unit : Unit
    * unit_head : Users.User
}

entity Announcements.Announcement {
    * id : number <<generated>>
    --
    * title : string
    * content : text
    * created_at : datetime
    * updated_at : datetime
    --
    * author : Users.User
    * unit_author : Units.Unit
}

entity Events.Event {
    * id : number <<generated>>
    --
    * title : string
    * description : text
    * start_time : datetime
    * end_time : datetime
    * location : GIS.Map.Place
    --
    * organizer : Units.Unit
}

entity GIS.Map.Place {
    * id : number <<generated>>
    --
    * name : string
    * description : text
    --
    * unit :  Units.Unit
    --
    * poligons : List<Polygon>
}



' inverse side -- owning side

Permissions.Permission }|--o{ Permissions.Permission_Scheme::permissions
Permissions.Permission_Scheme }|--o{ Permissions.Permission_Group

Permissions.Permission_Group }|--o{ Users.User::users

Users.Preference ||--|| Users.User
Users.Preference }|--o{ Units.Unit::units

Units.Unit ||--o{ Units.Unit::parent_unit
Units.Unit ||--o{ Users.User::unit_head

Announcements.Announcement ||--|| Users.User::author
Announcements.Announcement ||--o| Units.Unit::unit_author

Events.Event ||--|| Units.Unit::organizer
Events.Event::location ||--|| GIS.Map.Place

GIS.Map.Place::unit ||--|| Units.Unit

@enduml
